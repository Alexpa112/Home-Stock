venv/
__pycache__/
*.pyc
.pytest_cache/
# Directorios de datos de ejecucion COMPLETOS, no patrones por extension.
# El commit d3cb82d2 (2026-07-23) publico data/secret.json (la clave que firma
# las cookies de sesion), data/stock.db con usuarios y hashes reales, y 4900
# lineas de logs, porque los patrones de antes iban por extension y no cubrian
# lo que un `git add -A` arrastraba (p.ej. data/stock.db.backup.* que genera
# scripts/maintenance.sh). Ignorar el directorio entero es la unica forma de
# que no vuelva a pasar. Si algun dia hay que versionar algo de aqui, se
# desexcluye ese fichero concreto con `!`, nunca se afloja el patron.
data/
logs/
uploads/
.env
.env.*
!.env.example
server.log
server_dev.log
coverage/
node_modules/

# Frontend Next.js (rama dev2 integrada)
.next/
out/
next-env.d.ts
npm-debug.log
yarn-error.log
*.pem
install.log
.install.lock
tsconfig.tsbuildinfo
