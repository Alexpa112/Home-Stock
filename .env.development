# .env.development - Development configuration
# Copy this to .env for local testing

# OAuth - Google
# Get from: https://console.cloud.google.com/
# Default values for localhost testing
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth - Apple
# Get from: https://developer.apple.com/account/
# Default values for localhost testing
APPLE_CLIENT_ID=com.dreame.web
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_CLIENT_SECRET=your_apple_client_secret

# Email Configuration
# Leave SMTP_USER and SMTP_PASSWORD empty to use device client
# Email invitations will show a copyable link instead
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@homestock.local

# Application
APP_URL=http://localhost:5000

# Notes for Development:
# - Email invitations don't require SMTP configuration
# - Users will see a copyable link to share
# - Link can be shared via WhatsApp, email, or any other method
# - This respects user privacy (no third-party email service)
