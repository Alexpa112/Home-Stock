# syntax=docker/dockerfile:1
# Dockerfile para StockHogar en Raspberry Pi / Debian (ARM o x86)
# Bookworm (no Bullseye): los wheels de piwheels.org para numpy/opencv en armv7l
# están compilados contra glibc >= 2.34, que Bullseye (2.31) no tiene; Bookworm
# trae glibc 2.36 y evita el "GLIBC_2.34 not found" en tiempo de ejecución.
FROM python:3.14-slim-bookworm

LABEL maintainer="StockHogar Dev Team"
LABEL version="1.1"
LABEL description="StockHogar - Inventory Management System"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    TZ=Europe/Madrid \
    PORT=5000

# Paquetes de sistema: lo que hace falta para compilar/ejecutar las dependencias
# Python de requirements.txt (Tesseract para OCR, tesseract-ocr-spa para el
# idioma, toolchain para compilar en ARM lo que no tenga wheel prebuilt).
#
# A diferencia de los wheels oficiales de PyPI (que empaquetan sus propias
# librerías nativas), los wheels de piwheels.org (ver índice extra más abajo,
# necesarios porque PyPI no publica wheels para armv7l) enlazan dinámicamente
# contra librerías de sistema. Sin ellas, `import numpy`/`cv2` falla en
# tiempo de ejecución con "cannot open shared object file", no en el build.
# Confirmado con `ldd` sobre cv2.abi3.so + import real en un contenedor de
# prueba; lista completa de lo que requieren numpy y opencv-python-headless:
#   - libopenblas0: numpy (BLAS)
#   - libjpeg62-turbo, libwebp7, libwebpmux3, libwebpdemux2, libpng16-16,
#     libtiff6, libopenjp2-7: códecs de imagen de OpenCV
#   - libavcodec59, libavformat59, libavutil57, libswscale6: soporte de vídeo
#     de OpenCV (ffmpeg)
#   - liblapack3, libatlas3-base: LAPACK/CBLAS de OpenCV (libatlas3-base
#     provee libcblas.so.3 vía el sistema de alternativas de Debian)
#
# build-essential/pkg-config/libffi-dev/libssl-dev se conservan como red de
# seguridad por si una futura versión de alguna dependencia deja de publicar
# wheel para armv7l (ver opencv-python-headless en requirements.txt: pasó
# justo eso el 2026-07-28), aunque hoy nada se compila desde fuente. cryptography
# (que sí requería Rust) ya publica wheel armv7l prebuilt desde hace tiempo,
# así que se ha retirado el toolchain de Rust que se instalaba aquí antes.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        tesseract-ocr \
        tesseract-ocr-spa \
        libtesseract-dev \
        poppler-utils \
        libheif-examples \
        curl \
        build-essential \
        pkg-config \
        libffi-dev \
        libssl-dev \
        libopenblas0 \
        libjpeg62-turbo \
        libwebp7 \
        libwebpmux3 \
        libwebpdemux2 \
        libpng16-16 \
        libtiff6 \
        libopenjp2-7 \
        libavcodec59 \
        libavformat59 \
        libavutil57 \
        libswscale6 \
        liblapack3 \
        libatlas3-base \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Se copian primero solo las dependencias para aprovechar la cache de capas
# de Docker: si el código cambia pero requirements.txt no, no se reinstala nada.
COPY requirements.txt .
# piwheels.org publica wheels precompiladas para Raspberry Pi (armv7l/aarch64);
# se usa como índice extra (no sustituye a PyPI) para que opencv-python-headless
# no se compile desde fuente en la Pi, que es lo que más tarda del build entero.
#
# --mount=type=cache monta un caché de BuildKit persistente (fuera de las capas
# de la imagen) para los .whl ya descargados: aunque el instalador borre la
# caché de capas tras cada build (para no llenar el disco), esta caché de
# paquetes sigue viva y evita volver a descargar de red en cada actualización.
# Por eso aquí SÍ se quita --no-cache-dir (si no, pip no usaría este directorio).
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --upgrade pip setuptools wheel && \
    pip install --extra-index-url https://www.piwheels.org/simple -r requirements.txt

COPY . /app/

# Los tres pasos de abajo (directorios, Argos Translate, verificación de
# paquetes) van en un ÚNICO RUN a propósito: en el almacenamiento (SD/eMMC) de
# una Raspberry Pi, crear una capa nueva tiene un coste fijo de decenas de
# segundos casi independiente de lo que haga el comando (confirmado en
# install.log: tres RUN triviales de ~1s de trabajo real tardaron 70s+52s+109s
# = 231s solo en overhead de capa). Fusionarlos paga ese coste una vez.
#
# data/, logs/ y uploads/ ya se montan como volúmenes desde docker-compose.yml;
# se crean aquí también para que el healthcheck y una ejecución sin compose
# (docker run suelto) no fallen por directorios inexistentes.
#
# Argos Translate (es-en, en-es, en-fr, en-it, en-de, es-pt) se descarga en
# build-time (requiere red durante el build, pero deja el contenedor funcional
# sin conexión desde el primer arranque). ctranslate2 (dependencia de
# argostranslate) no publica binarios para armv7l (ver requirements.txt), así
# que en esa arquitectura se omite y traductor_auto.py cae al diccionario
# propio.
#
# La verificación final de imports/tesseract hace fallar el build aquí si
# falta algún paquete crítico, en vez de fallar en producción al primer
# request.
RUN mkdir -p /app/data /app/logs /app/uploads /app/stockhogar/servicios/ocr \
    && groupadd -g 1000 appuser && useradd -u 1000 -g appuser -M -s /usr/sbin/nologin appuser \
    && chown -R appuser:appuser /app/data /app/logs /app/uploads \
    && if [ "$(uname -m)" = "armv7l" ]; then \
        echo "[INFO] armv7l: Argos Translate no soportado (sin ctranslate2), se omite. Traduccion automatica usara el diccionario de fallback."; \
    else \
        python3 -c "from stockhogar.servicios.traductor_argos import _asegurar_paquetes_instalados; _asegurar_paquetes_instalados(); print('[OK] Modelos de Argos Translate descargados')"; \
    fi \
    && python3 -c "import flask, flask_wtf, cv2, pytesseract, fuzzywuzzy, gunicorn, platform, importlib; (importlib.import_module('argostranslate') if platform.machine() != 'armv7l' else None); print('[OK] Paquetes Python verificados')" \
    && tesseract --version | head -1 && echo "[OK] Tesseract instalado" \
    && pdftoppm -v > /dev/null 2>&1 && echo "[OK] Poppler (pdftoppm) instalado" \
    && command -v heif-convert > /dev/null && echo "[OK] libheif (heif-convert) instalado"

EXPOSE 5000

# NOTA (S-06): el propietario REAL en tiempo de ejecucion de ./data, ./logs y
# ./uploads (bind mounts, ver docker-compose.yml) depende de los permisos ya
# existentes en el HOST, no de este chown (que solo afecta a la capa de la
# imagen). Si el host no tiene esas carpetas con UID/GID 1000 (o world
# writable), appuser puede quedarse sin permiso de escritura al arrancar; hay
# que ajustar los permisos en el host, no intentar resolverlo aqui.
USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -fsS "http://localhost:${PORT}/" >/dev/null || exit 1

# gunicorn en vez del servidor de desarrollo de Flask: soporta varios workers
# y no muestra el aviso de "esto no es apto para producción" en los logs.
# --timeout 120 (por encima de los 30s por defecto): el preprocesado OpenCV
# + Tesseract de un ticket puede tardar bastante en hardware limitado como
# una Raspberry Pi, y con el timeout por defecto gunicorn mataba el worker
# a mitad de petición.
# --worker-class gthread --threads 4: con workers "sync" un escaneo de ticket
# ocupaba el worker entero (bloqueado) durante todo el OCR, dejando solo 1
# worker libre para el resto de la app; si en ese hueco entraban varias
# peticiones (p.ej. los botones +/- de stock) se quedaban en cola y el proxy
# delante de la app acababa devolviendo 502. Con hilos, el resto de peticiones
# se siguen atendiendo en paralelo dentro del mismo worker mientras el OCR corre.
CMD ["sh", "-c", "gunicorn --workers 2 --worker-class gthread --threads 4 --timeout 120 --bind 0.0.0.0:${PORT} --access-logfile - --error-logfile - 'stockhogar:create_app()'"]
