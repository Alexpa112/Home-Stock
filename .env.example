# OAuth Configuration
# Get credentials from:
# - Google: https://console.cloud.google.com/apis/credentials
# - Apple: https://developer.apple.com/account/resources/identifiers/list

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

APPLE_CLIENT_ID=your_apple_client_id_here
APPLE_CLIENT_SECRET=your_apple_client_secret_here
APPLE_TEAM_ID=your_apple_team_id_here

# Email Configuration (for sending list sharing invitations)
# Support SMTP servers: Gmail, Outlook, SendGrid, etc.

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=noreply@homestock.local

# Application
APP_URL=http://localhost:5000

# OCR de tickets: motor principal (gratis, API key en https://console.groq.com/keys).
# Sin esta clave, el escaneo de tickets usa el pipeline local (Tesseract) como respaldo.
GROQ_API_KEY=your_groq_api_key_here

# Motor de base de datos (opcional). Por defecto la app sigue en SQLite
# (data/stock.db) sin necesidad de definir nada aqui. DB_ENGINE=postgres es
# experimental (ver stockhogar/db_backend.py) y requiere haber migrado los
# datos antes con scripts/migrar_a_postgres.py.
# DB_ENGINE=sqlite
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=stockhogar
# POSTGRES_USER=stockhogar
# POSTGRES_PASSWORD=your_postgres_password_here
