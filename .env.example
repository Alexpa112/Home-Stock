# OAuth Configuration
# Get credentials from https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email Configuration (for sending list sharing invitations)
# Support SMTP servers: Gmail, Outlook, SendGrid, etc.

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=noreply@homestock.local

# Application
APP_URL=http://localhost:5000

# OCR de tickets: motor principal (Claude Vision API, gratis con free tier).
# API key: https://console.anthropic.com
# Sin esta clave, el escaneo de tickets usa el pipeline local (Tesseract) como respaldo.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Lector local de tickets: motor neuronal (RapidOCR, sin red) con Tesseract de
# respaldo. Opcionales: DREAME_OCR=tesseract fuerza solo Tesseract;
# DREAME_OCR_HILOS limita los hilos del motor neuronal (2 por defecto).
# Limite de memoria del backend: install.sh lo fija (1024m, o 768m en armv7l/poca RAM).
# DREAME_OCR=
# DREAME_OCR_HILOS=2
# STOCKHOGAR_MEM_LIMIT=1024m

# Motor de base de datos (opcional). Por defecto la app sigue en SQLite
# (data/stock.db) sin necesidad de definir nada aqui. DB_ENGINE=postgres es
# experimental (ver stockhogar/db_backend.py) y requiere haber migrado los
# datos antes con scripts/migrar_a_postgres.py.
# DB_ENGINE=sqlite
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=stockhogar
# POSTGRES_USER=stockhogar
# POSTGRES_PASSWORD=your_postgres_password_here
