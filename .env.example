# StockHogar Environment Configuration

# Flask Settings
FLASK_APP=stockhogar
FLASK_ENV=production
FLASK_DEBUG=0

# Logging
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:////app/data/stockhogar.db

# Server
STOCKHOGAR_PORT=5000
WORKERS=4
TIMEOUT=120

# Security (cambiar en produccion)
SECRET_KEY=tu-clave-secreta-muy-larga-aqui

# Session
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# OCR
OCR_CONFIDENCE_THRESHOLD=60
OCR_TIMEOUT=30

# Uploads
MAX_UPLOAD_SIZE=10485760

# Timezone
TZ=Europe/Madrid
