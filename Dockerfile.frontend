# syntax=docker/dockerfile:1
# Dockerfile del frontend Next.js (rediseño de la rama dev2).
# node:20-bookworm-slim: mismo Debian base que Dockerfile.raspbian, y Node 20
# sigue publicando manifiesto multi-arco con linux/arm/v7 y linux/arm64,
# necesarios para Raspberry Pi (32-bit y 64-bit respectivamente). Si en el
# futuro Node deja de publicar armv7, este build fallará en Pi de 32-bit y
# habrá que fijar una version anterior o migrar a 64-bit.
FROM node:20-bookworm-slim AS builder
WORKDIR /app

COPY package.json package-lock.json* pnpm-lock.yaml* ./
# --mount=type=cache: igual que en Dockerfile.raspbian, cachea los paquetes
# descargados (~/.npm o el store de pnpm) fuera de las capas de la imagen, para
# que sobrevivan a la purga de caché de capas que hace install.sh tras cada
# build sin necesidad de conservar la imagen intermedia completa.
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked \
    if [ -f pnpm-lock.yaml ]; then \
        corepack enable && corepack prepare pnpm@latest --activate && pnpm install --frozen-lockfile; \
    else \
        npm ci; \
    fi

# OJO: cada carpeta de fuentes de primer nivel que se importe con el alias "@/"
# tiene que estar copiada aquí. Si falta una, "next build" no falla al copiar,
# falla 7 minutos después con "Module not found: Can't resolve '@/...'".
# install.sh comprueba esta correspondencia antes de arrancar el build.
COPY app ./app
COPY components ./components
COPY contexts ./contexts
COPY hooks ./hooks
COPY lib ./lib
COPY public ./public
COPY middleware.ts next.config.mjs tailwind.config.ts postcss.config.mjs tsconfig.json components.json ./

# URL del backend Flask DENTRO de la red de docker-compose (nombre del
# servicio "stockhogar", no localhost): la usa next.config.mjs en su función
# rewrites(), que corre en el servidor de Next, no en el navegador.
ARG NEXT_PUBLIC_API_URL=http://stockhogar:5000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
# --webpack: Turbopack (motor por defecto de "next build" en Next 16) solo
# tiene bindings nativos, sin soporte para linux/arm (Raspberry Pi 32-bit);
# ahi solo se cargan bindings WASM, que Turbopack no puede usar, y el build
# falla con "Turbopack is not supported on this platform". Webpack sí
# funciona en todas las arquitecturas.
# NODE_OPTIONS=--unhandled-rejections=warn: Next.js ya no publica el binario
# nativo de SWC para linux/arm (32-bit) desde la v13.2.5 en adelante. En su
# lugar cae automaticamente al binding WASM (que sí funciona), pero un hilo
# interno intenta ADEMÁS descargar el paquete nativo inexistente y esa
# promesa rechazada sin capturar mata el proceso entero (Node aborta ante
# cualquier unhandledRejection). Sin esta opción, el build siempre falla en
# Raspberry Pi de 32-bit aunque el fallback WASM habría sido suficiente.
RUN if [ -f pnpm-lock.yaml ]; then \
        corepack enable && NODE_OPTIONS=--unhandled-rejections=warn pnpm run build -- --webpack; \
    else \
        NODE_OPTIONS=--unhandled-rejections=warn npm run build -- --webpack; \
    fi

FROM node:20-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=3000
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.mjs ./

ARG NEXT_PUBLIC_API_URL=http://stockhogar:5000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

EXPOSE 3000

# Usuario no privilegiado (S-06): Next.js en modo "start" no necesita escribir
# en ningun bind mount de este servicio (no hay volumes en docker-compose.yml
# para "frontend"), asi que a diferencia del backend no hace falta ningun
# chown adicional. Se reutiliza el usuario "node" que ya trae la imagen base
# node:*-slim (UID/GID 1000) en vez de crear uno propio: crear "appuser" con
# -u 1000 -g 1000 chocaba con ese usuario ya existente ("useradd: UID 1000
# is not unique", exit code 4) y rompia el build.
RUN chown -R node:node /app
USER node

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -fsS "http://localhost:3000/" >/dev/null || exit 1

# next start (servidor de produccion): nunca "next dev" en el contenedor, que
# es mas lento y expone el overlay de errores de desarrollo.
CMD ["npm", "run", "start"]
